{
  "name": "linscanner",
  "category": "app",
  "description": "Universal document scanner for Linux (SANE)",
  "installer": "install.sh",
  "run_as": "user",
  "offline": {
    "apt": [
      "python3",
      "python3-gi",
      "python3-gi-cairo",
      "gir1.2-gtk-3.0",
      "python3-pil",
      "sane-utils",
      "libsane1",
      "sane-airscan",
      "python3-numpy",
      "tesseract-ocr",
      "tesseract-ocr-eng",
      "tesseract-ocr-osd",
      "ghostscript",
      "fontconfig",
      "fonts-dejavu-core",
      "fonts-liberation",
      "fonts-noto-core",
      "fonts-urw-base35",
      "fonts-ubuntu"
    ]
  }
}
